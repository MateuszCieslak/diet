# MySQL 8 connection string
DATABASE_URL="mysql://diet:password@localhost:3306/diet"
# Shared app password and the secret used to sign the session cookie
APP_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-long-random-string"
# Directory for meal photos (absolute path on the server)
PHOTOS_DIR="/var/lib/diet/photos"
TZ="Europe/Warsaw"

# adapter-node
BODY_SIZE_LIMIT=10M
